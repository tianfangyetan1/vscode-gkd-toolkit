{
  "name": "gkd-toolkit",
  "displayName": "GKD Toolkit",
  "description": "GKD Toolkit for VS Code",
  "version": "1.2.2",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gkd-toolkit.openAllSnapshotUrls",
        "title": "全部打开",
        "category": "GKD Toolkit"
      },
      {
        "command": "gkd-toolkit.openAllSnapshotUrlsWithQuery",
        "title": "全部打开并查询",
        "category": "GKD Toolkit"
      },
      {
        "command": "gkd-toolkit.collapseAllRules",
        "title": "折叠所有规则",
        "category": "GKD Toolkit"
      },
      {
        "command": "gkd-toolkit.copyCurrentGroup",
        "title": "复制当前规则组",
        "category": "GKD Toolkit"
      }
    ],
    "configuration": {
      "title": "GKD Toolkit",
      "properties": {
        "gkd-toolkit.outline.hideSingleRule": {
          "order": 0,
          "type": "boolean",
          "default": true,
          "description": "当规则组内只有一条规则时，不在大纲中单独显示规则。"
        },
        "gkd-toolkit.append.confirm": {
          "order": 1,
          "type": "boolean",
          "default": true,
          "description": "通过 vscode:// 协议追加规则组前弹窗确认。"
        },
        "gkd-toolkit.append.format": {
          "order": 2,
          "type": "boolean",
          "default": true,
          "description": "通过 vscode:// 协议追加规则组后格式化该文档。"
        },
        "gkd-toolkit.append.overwriteKey": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "description": "通过 vscode:// 协议追加规则组时覆写新组的 key。值为追加前最大的 key 值 +1，如果是新建的文件则值为 1。"
        },
        "gkd-toolkit.uri.workspacePath": {
          "order": 4,
          "type": "string",
          "default": "",
          "description": "当打开包含多个 GKD 订阅的工作区时，通过 vscode:// 协议跳转默认使用的项目根目录绝对路径。"
        },
        "gkd-toolkit.collapseAllRules.show": {
          "order": 5,
          "type": "boolean",
          "default": false,
          "description": "实验性：在规则文件顶部显示「折叠所有规则」按钮，下次打开时自动展开折叠的部分。"
        }
      }
    }
  },
  "publisher": "tianfangyetan",
  "author": {
    "name": "tianfangyetan1"
  },
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianfangyetan1/vscode-gkd-toolkit.git"
  },
  "scripts": {
    "build": "vsce package",
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}